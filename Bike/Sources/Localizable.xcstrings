        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 위치에서 출발해 한 바퀴 돌아 시작점으로"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從目前位置出發，繞一圈回到起點"
