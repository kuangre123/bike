          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포장도로와 자갈길을 함께 이용하고 큰길을 피합니다"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
