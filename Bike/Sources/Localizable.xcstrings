    "Pro 已激活，全部功能已解锁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro active — all features unlocked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro有効 — すべての機能が解放"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 활성화 — 모든 기능 잠금 해제"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 已啟用，全部功能已解鎖"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro aktiv – alle Funktionen frei"
          }
        }
      }
    },
    "Pro 解锁安静风景路线推荐、逐向导航与高级统计。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro unlocks quiet scenic route suggestions, turn-by-turn navigation, and advanced stats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Proで静かな絶景ルート提案・ターンバイターンナビ・詳細統計が使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro로 조용한 경치 좋은 경로 추천, 턴바이턴 내비게이션, 고급 통계를 잠금 해제합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 解鎖安靜風景路線推薦、逐向導航與進階統計。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro schaltet ruhige Panoramarouten, Turn-by-Turn-Navigation und erweiterte Statistiken frei."
          }
        }
      }
    },
